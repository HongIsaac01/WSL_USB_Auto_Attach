{
  "name": "wsl-usb-manager",
  "displayName": "WSL USB Manager",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
     "workspace"
  ],
  "activationEvents": [
    "onView:wslUsbManager.devicesView",

    "onCommand:wslUsbManager.showDevices",
    "onCommand:wslUsbManager.attachDevice",
    "onCommand:wslUsbManager.detachDevice",
    "onCommand:wslUsbManager.manageAutoAttach",
    "onCommand:wslUsbManager.showAttachedDevices",

    "onCommand:wslUsbManager.refresh",
    "onCommand:wslUsbManager.treeAttach",
    "onCommand:wslUsbManager.treeDetach",
    "onCommand:wslUsbManager.treeEnableAutoAttach",
    "onCommand:wslUsbManager.treeDisableAutoAttach",
    "onCommand:wslUsbManager.renameDevice"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
          "command": "wslUsbManager.showDevices",
          "title": "WSL USB: Show Devices"
      },
      {
          "command": "wslUsbManager.attachDevice",
          "title": "WSL USB: Attach Device"
      },
      {
          "command": "wslUsbManager.detachDevice",
          "title": "WSL USB: Detach Device"
      },
      {
        "command":
            "wslUsbManager.manageAutoAttach",
        "title":
            "WSL USB: Manage Auto Attach Devices"
      },
      {
          "command": "wslUsbManager.showAttachedDevices",
          "title": "WSL USB: Show Attached Devices"
      },
      {
          "command": "wslUsbManager.refresh",
          "title": "Refresh USB Devices",
          "icon": "$(refresh)"
      }, 
      {
          "command": "wslUsbManager.treeAttach",
          "title": "Attach to WSL",
          "icon": "$(plug)"
      },
      {
          "command": "wslUsbManager.treeDetach",
          "title": "Detach from WSL",
          "icon": "$(debug-disconnect)"
      },
      {
          "command": "wslUsbManager.treeEnableAutoAttach",
          "title": "Enable Auto Attach",
          "icon": "$(pass)"
      },
      {
          "command": "wslUsbManager.treeDisableAutoAttach",
          "title": "Disable Auto Attach",
          "icon": "$(close)"
      },
      {
          "command": "wslUsbManager.renameDevice",
          "title": "Rename Device",
          "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wslUsbManager",
          "title": "WSL USB",
          "icon": "media/usb.svg"
        }
      ]
    },
    "views": {
      "wslUsbManager": [
        {
          "id": "wslUsbManager.devicesView",
          "name": "USB Devices"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wslUsbManager.refresh",
          "when": "view == wslUsbManager.devicesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
          {
              "command": "wslUsbManager.treeAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == availableDevice",
              "group": "inline"
          },
          {
              "command": "wslUsbManager.treeAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == availableAutoDevice",
              "group": "inline"
          },

          {
              "command": "wslUsbManager.treeDetach",
              "when": "view == wslUsbManager.devicesView && viewItem == attachedDevice",
              "group": "inline"
          },
          {
              "command": "wslUsbManager.treeDetach",
              "when": "view == wslUsbManager.devicesView && viewItem == attachedAutoDevice",
              "group": "inline"
          },
          {
              "command": "wslUsbManager.treeEnableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == availableDevice",
              "group": "auto@1"
          },
          {
              "command": "wslUsbManager.treeEnableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == attachedDevice",
              "group": "auto@1"
          },
          {
              "command": "wslUsbManager.treeDisableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == availableAutoDevice",
              "group": "auto@1"
          },
          {
              "command": "wslUsbManager.treeDisableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == attachedAutoDevice",
              "group": "auto@1"
          },
          {
              "command": "wslUsbManager.treeDisableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == managedAttachedDevice",
              "group": "inline"
          },
          {
              "command": "wslUsbManager.treeDisableAutoAttach",
              "when": "view == wslUsbManager.devicesView && viewItem == managedAvailableDevice",
              "group": "inline"
          },
          {
              "command": "wslUsbManager.renameDevice",
              "when": "view == wslUsbManager.devicesView && viewItem =~ /Device$/",
              "group": "edit@1"
          }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
